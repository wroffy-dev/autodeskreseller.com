{
  "name": "dropbox-reseller",
  "version": "1.2.0",
  "release": {
    "date": "2026-10-07"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "seed:build": "npm run seed:build:all && npm run seed:build:steps",
    "seed:build:all": "esbuild prisma/seed.ts --bundle --platform=node --target=node22 --format=esm --outfile=prisma/seed.mjs --external:@prisma/client --external:bcryptjs",
    "seed:build:steps": "esbuild prisma/seed/*.ts --bundle --platform=node --target=node22 --format=esm --outdir=prisma/seed --out-extension:.js=.mjs --external:@prisma/client --external:bcryptjs",
    "seed:prod": "node prisma/seed.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "db:rehearse": "node scripts/rehearse-migration.mjs",
    "check:indexing": "node scripts/check-indexing.mjs",
    "check:domain": "node scripts/check-domain.mjs",
    "urls:backfill": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/urls-backfill.ts",
    "market:clone": "node scripts/clone-market.mjs",
    "release": "node scripts/release.mjs",
    "admin:dark-css": "node scripts/admin-dark-css.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-storage": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "isomorphic-dompurify": "^4.1.0",
    "lucide-react": "^1.42.0",
    "next": "^15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "otpauth": "^9.5.2",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.6.0",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
