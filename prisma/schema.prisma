// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String // created | updated | deleted | published | ...
  entity     String // Page | Product | Lead | ...
  entityId   String?
  summary    String? @db.Text
  before     Json?
  after      Json?
  ipHash     String?
  userAgent  String? @db.Text

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

/// A single backup archive.
///
/// The row is created before the work starts so a crashed or killed process
/// still leaves a visible FAILED record rather than nothing at all.
model Backup {
  id      String        @id @default(cuid())
  type    BackupType
  status  BackupStatus  @default(PENDING)
  storage BackupStorage
  origin  BackupOrigin  @default(MANUAL)

  fileName   String?
  /// Key within the backup storage provider. Never a user-supplied path.
  storageKey String?
  /// Archives can exceed 2 GB, which overflows a 32-bit Int.
  sizeBytes  BigInt?
  /// SHA-256 of the finished archive, re-verified before any restore.
  checksum   String?

  /// Copied from manifest.json so History can be read without opening archives.
  manifestVersion  Int?
  appVersion       String?
  mediaIncluded    Boolean @default(false)
  databaseIncluded Boolean @default(false)

  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  /// Sanitised before storage — never contains a connection string or secret.
  errorMessage String?   @db.Text

  createdById String?
  /// Retained for compatibility with the original spec; mirrors origin != MANUAL.
  automatic   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User?           @relation("BackupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  restores  BackupRestore[]

  @@index([createdAt])
  @@index([status])
  @@index([type, status])
  @@index([origin])
}

/// One restore attempt, kept even when it fails so the history is auditable.
model BackupRestore {
  id       String       @id @default(cuid())
  backupId String
  status   BackupStatus @default(RUNNING)

  /// The safety backup taken immediately before this restore.
  safetyBackupId String?

  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  failedAt     DateTime?
  errorMessage String?   @db.Text

  restoredById String?

  backup Backup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId])
  @@index([startedAt])
}

/// Schedule for automatic backups. A singleton, like the other settings rows.
model BackupSchedule {
  id      String  @id @default("singleton")
  enabled Boolean @default(false)

  /// daily | weekly | monthly
  frequency  String     @default("daily")
  hour       Int        @default(3)
  minute     Int        @default(0)
  /// Day of week for weekly (0 = Sunday) or day of month for monthly.
  dayOfWeek  Int        @default(0)
  dayOfMonth Int        @default(1)
  backupType BackupType @default(FULL)
  timezone   String     @default("Asia/Kolkata")

  retentionDaily   Int @default(7)
  retentionWeekly  Int @default(4)
  retentionMonthly Int @default(3)

  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-row claim guarding backup and restore.
///
/// An advisory lock alone is re-entrant within a session, and Prisma pools
/// connections, so two acquisitions can share a connection and both succeed.
/// This row is unambiguous across connections; `expiresAt` lets a claim left
/// by a killed container lapse rather than blocking the system forever.
model BackupLock {
  id         String   @id @default("singleton")
  operation  String
  holder     String?
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
}

// ---------------------------------------------------------------------------
// CONSENT
// ---------------------------------------------------------------------------

/**
 * A version of the consent notice shown beside a form.
 * Immutable once published. Editing the wording in the CMS writes a new
 * version rather than changing this row, because a submission stores which
 * version it was shown and that has to stay readable years later — the point
 * of the record is to prove what the person actually agreed to.
 */
model ConsentNotice {
  id        String  @id @default(cuid())
  /// Groups the versions of one notice. "default" is the site-wide one.
  key       String
  version   Int
  /// The version served to new submissions. Exactly one per key; the save
  /// action moves it forward.
  isCurrent Boolean @default(false)

  /// Null means the notice applies to every market.
  countryId String?

  /// What the information is collected for, in plain words. Shown above the
  /// tick boxes and copied into every submission's evidence.
  purposeText String @db.Text

  /// The required processing tick box.
  enquiryLabel   String @db.Text
  /// The optional marketing tick box. Never required to submit.
  marketingLabel String @db.Text
  /// The Terms acceptance tick box, when the form asks for one.
  termsLabel     String @db.Text
  /// How to withdraw consent or ask a question about the data.
  withdrawalText String @db.Text

  privacyUrl     String
  privacyVersion String?
  termsUrl       String
  termsVersion   String?

  createdAt   DateTime @default(now())
  createdById String?

  country   Country?        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("ConsentNoticeAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  records   ConsentRecord[]

  @@unique([key, version])
  @@index([key, isCurrent])
  @@index([countryId])
}

/**
 * What one person agreed to, at the moment they submitted.
 * The notice text is snapshotted rather than referenced alone: a notice row
 * can be deleted, a country can be removed, and the evidence still has to say
 * exactly what was on screen. The three consents stay three columns — folding
 * them into one boolean would lose the distinction between "agreed we may
 * answer the enquiry" and "agreed to marketing", which are different
 * permissions with different consequences.
 */
model ConsentRecord {
  id String @id @default(cuid())

  leadId       String?
  submissionId String? @unique
  countryId    String?

  noticeId       String?
  noticeKey      String
  noticeVersion  Int
  /// Exact wording shown, as rendered. Kept even if the notice row goes away.
  noticeSnapshot Json
  purposeText    String  @db.Text

  lawfulBasis LawfulBasis @default(CONSENT)

  /// Agreed the enquiry may be processed. Required when the basis is CONSENT.
  enquiryConsent   Boolean @default(false)
  /// Optional. Never a condition of submitting.
  marketingConsent Boolean @default(false)
  /// Only meaningful when the form asked for Terms acceptance.
  termsAccepted    Boolean @default(false)
  termsRequired    Boolean @default(false)

  /// Was marketing wording actually on screen? Null on every record written
  /// before the combined box existed — "not recorded", never guessed either
  /// way, so historical evidence is not reinterpreted.
  marketingPresented Boolean?
  /// The exact sentence beside the tick box, as the visitor saw it. Null for
  /// records written before there was one, and for forms that show no box.
  displayedLabel     String?  @db.Text
  /// Which market's notice was shown: null for the shared one, otherwise the
  /// country code. Stored as a code rather than an id so the evidence still
  /// reads correctly after a market is removed.
  noticeScope        String?

  privacyUrl     String
  privacyVersion String?
  termsUrl       String
  termsVersion   String?

  /// Server clock, UTC. Never taken from the browser.
  consentedAt DateTime @default(now())

  /// Set when consent is withdrawn. The booleans above are left as they were:
  /// this points at the withdrawal, it does not rewrite what was agreed.
  withdrawnAt    DateTime?
  withdrawnScope ConsentScope?

  lead       Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  submission FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  country    Country?        @relation(fields: [countryId], references: [id], onDelete: SetNull)
  notice     ConsentNotice?  @relation(fields: [noticeId], references: [id], onDelete: SetNull)
  events     ConsentEvent[]

  @@index([leadId])
  @@index([countryId, consentedAt])
  @@index([marketingConsent, withdrawnAt])
}

/**
 * Append-only history for one consent record.
 */
model ConsentEvent {
  id       String           @id @default(cuid())
  recordId String
  type     ConsentEventType
  scope    ConsentScope

  /// The value the scope moved to, so the log reads without inference.
  value Boolean

  /// Who caused it: the visitor at submission, or a staff member acting on a
  /// request. Null actor with VISITOR source is the original grant.
  actorId   String?
  actorType String  @default("VISITOR")
  note      String? @db.Text
  ipAddress String?

  createdAt DateTime @default(now())

  record ConsentRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  actor  User?         @relation("ConsentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recordId, createdAt])
}

// ---------------------------------------------------------------------------
// COUNTRY CONTENT SYNC
// ---------------------------------------------------------------------------

/**
 * One row per record copied from the source market into a destination market.
 * This is what makes a repeat run idempotent: the sync looks up the source id
 * here before creating anything, so running it twice updates or skips rather
 * than producing a second copy. `locallyEdited` is set when the destination
 * row changes after import, which is how "preserve local changes" is decided
 * without guessing from timestamps alone.
 */
model CountrySyncMapping {
  id              String @id @default(cuid())
  sourceCountryId String
  targetCountryId String

  /// PAGE | PRODUCT | FORM — the allowlist lives in code, not here.
  entityType String
  sourceId   String
  targetId   String

  /// The source row's updatedAt at the last successful copy, so a later run
  /// can tell whether the source actually changed.
  sourceUpdatedAt   DateTime?
  /// The destination row's updatedAt just after the copy. A destination whose
  /// updatedAt has moved past this has been edited locally.
  targetSyncedAt    DateTime?
  /// When the destination copy was found to be gone.
  ///
  /// A tombstone, and the reason this table has no foreign key to the row it
  /// points at: deleting the copy must leave this record standing, because it
  /// is the only evidence that the market once had the item and chose to
  /// remove it. Without it the next run would see "missing" and helpfully put
  /// it back, undoing a deliberate decision every single time.
  deletedInTargetAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceCountry Country @relation("SyncSource", fields: [sourceCountryId], references: [id], onDelete: Cascade)
  targetCountry Country @relation("SyncTarget", fields: [targetCountryId], references: [id], onDelete: Cascade)

  @@unique([targetCountryId, entityType, sourceId])
  @@index([targetCountryId, entityType])
  @@index([sourceCountryId])
}

/**
 * One execution of the sync, with its counts and audit log.
 */
model CountrySyncRun {
  id              String     @id @default(cuid())
  sourceCountryId String
  targetCountryId String
  mode            SyncMode   @default(ADD_MISSING)
  status          SyncStatus @default(PENDING)

  /// Set for a dry run that only reports what would happen.
  previewOnly Boolean @default(false)

  createdCount  Int @default(0)
  updatedCount  Int @default(0)
  skippedCount  Int @default(0)
  conflictCount Int @default(0)
  failedCount   Int @default(0)

  /// Per-entity detail: what was created, skipped, and why.
  log   Json    @default("[]")
  error String? @db.Text

  startedById String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  sourceCountry Country @relation("SyncRunSource", fields: [sourceCountryId], references: [id], onDelete: Cascade)
  targetCountry Country @relation("SyncRunTarget", fields: [targetCountryId], references: [id], onDelete: Cascade)
  startedBy     User?   @relation("SyncRunActor", fields: [startedById], references: [id], onDelete: SetNull)

  @@index([targetCountryId, startedAt])
  @@index([status])
}
